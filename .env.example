# Copiá este archivo con el nombre ".env" y completá los tres valores de abajo.
# (En Vercel estos mismos valores se cargan en Settings > Environment Variables.)

# Dirección de conexión de Neon (la que empieza con postgresql://...)
DATABASE_URL=

# Contraseña para entrar al panel (/admin). Mínimo 8 caracteres.
ADMIN_PASSWORD=

# Texto largo y aleatorio (mínimo 16 caracteres). Para generar uno:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

PORT=3000

# Opcionales
# CUPOS=1                       autos que se atienden a la vez por horario
# MOSTRAR_ACCESO_ADMIN=false    oculta la ventana inicial "Soy administrador" (se abre con /?admin)
