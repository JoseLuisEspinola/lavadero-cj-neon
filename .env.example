# Copiá este archivo como .env y completá los valores.
# En Vercel, configurá las mismas variables en Settings > Environment Variables.

# URL de conexión de Neon (postgresql://...)
DATABASE_URL=

# Contraseña del panel DATOS (mínimo 8 caracteres)
ADMIN_PASSWORD=

# Secreto aleatorio para firmar sesiones (mínimo 16 caracteres)
SESSION_SECRET=

PORT=3000

# Opcional: cantidad de vehículos por horario
# CUPOS=1
